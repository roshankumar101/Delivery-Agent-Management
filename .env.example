# App configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=change-me-in-production
CLIENT_URL=http://localhost:8080,http://localhost:5173
ADMIN_NAME=Testing
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Database
# For production Compose, replace these placeholders and set DATABASE_URL to use the postgres service hostname.
POSTGRES_USER=delivery_app
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=delivery_agent_management

DATABASE_URL=postgresql://delivery_app:change-this-database-password@postgres:5432/delivery_agent_management?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Frontend backend API origin (the client appends /api)
VITE_API_URL=http://localhost:5000
