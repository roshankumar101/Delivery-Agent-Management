generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
}

enum AgentStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model DeliveryAgent {
  id            String              @id @default(cuid())
  fullName      String
  phone         String              @unique
  email         String              @unique
  serviceArea   String
  status        AgentStatus         @default(ACTIVE)
  deletedAt     DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  modifications AgentModification[]

  @@index([status])
  @@index([serviceArea])
  @@index([deletedAt])
  @@index([createdAt])
}

model AgentModification {
  id                 String        @id @default(cuid())
  agentId            String
  modificationNumber Int
  changedFields      Json
  previousValues     Json
  newValues          Json
  modifiedAt         DateTime      @default(now())
  agent              DeliveryAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, modificationNumber])
  @@index([agentId, modifiedAt])
}
